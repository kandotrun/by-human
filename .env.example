DATABASE_URL=postgres://byhuman:local-test-only@127.0.0.1:5432/byhuman
BY_HUMAN_LISTEN=127.0.0.1:4310
BY_HUMAN_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
BY_HUMAN_OPENAI_AUTH=chatgpt
# Optional dedicated owner-only directory; default: ~/.config/by-human
# BY_HUMAN_AUTH_DIR=/absolute/path/to/by-human-auth
OPENAI_MODEL=gpt-6.2-sol
# Optional explicit MCP connections; see docs/mcp.md and mcp.example.json.
# BY_HUMAN_MCP_CONFIG=/absolute/path/to/mcp.json
# OpenAI's hosted web search: on (default) or off.
# BY_HUMAN_WEB_SEARCH=on
# Used only when BY_HUMAN_OPENAI_AUTH=api-key is explicitly selected.
# OPENAI_API_KEY=
